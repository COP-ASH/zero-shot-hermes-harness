# UP Police Data Analyst Agent — environment.
# Copy to .env and set the provider key. The provider is auto-detected
# from whichever key is set (or force it with AGENT_LLM_PROVIDER).
# .env is gitignored and is the ONLY manual setup step. Never commit real keys.

# --- Database (defaults to a local SQLite file) ---
AGENT_DATABASE_URL=sqlite:///./data/app.db

# --- Upload directory for CSV files ---
AGENT_UPLOAD_DIR=./data/uploads

# --- LLM provider: auto | anthropic | gemini | openrouter ---
AGENT_LLM_PROVIDER=auto
# Recommended model for UP Police agent:
AGENT_LLM_MODEL=anthropic/claude-sonnet-4-6

# Set exactly ONE of these (matching your chosen provider):
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=
AGENT_OPENROUTER_API_KEY=

# --- Server ---
PORT=8001
AGENT_LOG_LEVEL=INFO

# --- Phase 2: MSSQL Integration (leave blank for Phase 1) ---
# AGENT_MSSQL_DSN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=hostname;DATABASE=uppolice;UID=readonly_user;PWD=password
# AGENT_CACHE_TTL_SECONDS=300
